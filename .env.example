# ============================================================
# .env.example — copy to .env and fill in the values:  cp .env.example .env
# .env is git-ignored (see .gitignore)
# ============================================================

# --- Application ---
APP_PORT=8080
APP_ENV=development            # development | production

# --- Database (PostgreSQL) ---
# Format: postgres://USER:PASSWORD@HOST:PORT/DBNAME?sslmode=disable
# On local Homebrew, the default user is your OS username, with no password:
DATABASE_URL=postgres://jagadpurnomo@localhost:5432/expense_tracker?sslmode=disable

# --- OAuth token encryption (AES-256-GCM) ---
# A 32-byte key encoded as base64. Generate it once, store it safely, and never
# change it (rotating it makes already-encrypted tokens in the DB undecryptable).
# Generate:  openssl rand -base64 32
ENCRYPTION_KEY=

# --- Session-based auth ---
# Secret used to sign the session cookie. Generate:  openssl rand -base64 32
SESSION_SECRET=

# --- Google OAuth2 (Gmail API, read-only) ---
# Download credentials.json from the Google Cloud Console:
#   APIs & Services > Credentials > Create OAuth client ID > Web application
# Place the file in the project root (already git-ignored).
GOOGLE_CREDENTIALS_PATH=./credentials.json
# Must match the "Authorized redirect URI" in the Google Cloud Console exactly:
GOOGLE_REDIRECT_URL=http://localhost:8080/auth/google/callback

# --- IMAP IDLE (real-time new-email detection) ---
# Requires 2FA enabled, then generate an App Password at:
#   https://myaccount.google.com/apppasswords
GMAIL_IMAP_HOST=imap.gmail.com:993
GMAIL_IMAP_USER=               # your Gmail address
GMAIL_IMAP_APP_PASSWORD=       # 16-character app password (no spaces)

# --- Gmail sync (FR-02: configurable, not hardcoded) ---
# Sender addresses are managed in the sender_filters DB table, not here —
# see migrations/002_sender_filters.sql. Insert rows by hand via psql.

# ============================================================
# Used in later epics (no need to fill in yet):
# ============================================================
# ANTHROPIC_API_KEY=           # Epic 2: LLM extraction (Haiku) & Q&A (Sonnet)
# RESEND_API_KEY=              # Epic 4: send alert emails
